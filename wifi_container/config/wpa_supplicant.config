# CONFIG_CTRL_IFACE_DIR is not exposed as a make variable
EXTRA_CFLAGS = -DCONFIG_CTRL_IFACE_DIR='"/run/wifi-fixture/wpa_supplicant"'

# Workaround: install target looks for wpa_passphrase but it is missing from BINALL
BINALL += wpa_passphrase

CONFIG_CTRL_IFACE=y
CONFIG_DRIVER_NL80211=y

# WPA2/WPA3 station support.
CONFIG_IEEE8021X_EAPOL=y
CONFIG_SAE=y
CONFIG_NO_TKIP=y

# 802.1X / EAP-TLS support (PDC)
CONFIG_IEEE8021X_AUTH=y
CONFIG_TLSV11=y
CONFIG_TLSV12=y
CONFIG_EAP_TLS=y

# Wi-Fi PAF / Un-synchronized Service Discovery
CONFIG_NAN_USD=y
