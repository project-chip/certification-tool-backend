# CONFIG_CTRL_IFACE_DIR is not exposed as a make variable
EXTRA_CFLAGS = -DCONFIG_CTRL_IFACE_DIR='"/run/wifi-fixture/hostapd"'

CONFIG_CTRL_IFACE=y
CONFIG_DRIVER_NL80211=y

# 802.11n/ac + WPA3 (SAE) so the AP can offer modern security.
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_SAE=y

# Per-Device Credential (PDC) / Matter-specific AP authentication options
CONFIG_EAP=y
CONFIG_EAP_TLS=y
CONFIG_EAP_TLS_PINNING=y
